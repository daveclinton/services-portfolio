# Frontend environment template — copy to .env.local and fill in.
#
# Only this template is committed; .env.local never is.
#
# These keys are SERVER-ONLY (no NEXT_PUBLIC_ prefix): they are read by the
# Next.js API routes in app/api/, which run on the server. Anything with a
# NEXT_PUBLIC_ prefix is baked into the browser bundle — never put secrets
# there. The browser only ever talks to our own same-origin /api/* routes.

# Neon Postgres. Use the *direct* (5432) connection so local ingestion and
# migrations work; the serverless routes use Neon's HTTP driver, which needs
# no connection pooling settings.
DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# OpenAI (chat + query embeddings). You create this yourself at
# https://platform.openai.com/api-keys and paste it here locally, plus in
# Vercel Project → Settings → Environment Variables (Production and Preview).
OPENAI_API_KEY=

# Anonymous AI rate limiting. Create a REST Redis database in Upstash, then
# copy its REST credentials. RATE_LIMIT_SECRET signs visitor cookies and hashes
# IP addresses; use a random value of at least 32 characters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=

# Optional site-wide circuit breakers. These defaults apply when omitted.
AI_GLOBAL_DAILY_LIMIT=200
SEARCH_GLOBAL_DAILY_LIMIT=2000

# Prepare the database with the offline Python pipeline (same DATABASE_URL):
#   cd backend && source .venv/bin/activate
#   python manage.py migrate
#   python manage.py ingest_knowledge && python manage.py embed_knowledge
