# The only setting the frontend needs: the base URL of the Go API in backend/
# (no trailing slash). Locally, start it with `make up` in backend/ and use
# http://localhost:8080. In Vercel, set it to the production API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Same private value in frontend and backend (32+ characters). Allows the API
# to refresh public posts immediately after publishing. Never NEXT_PUBLIC_.
CONTENT_REVALIDATION_SECRET=
