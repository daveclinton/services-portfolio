# Frontend environment template — copy to .env.local and fill in.
#
# The browser calls the Django API directly (see lib/ai-client.ts), and
# NEXT_PUBLIC_* values are baked into the bundle at build time, so changing one
# needs a rebuild, not a restart. Only this template is committed; .env.local
# never is.

# Local Django dev server (`python manage.py runserver`):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Vercel: set the same variable for Production *and* Preview in
# Project → Settings → Environment Variables, pointing at the Fly app:
#   NEXT_PUBLIC_API_BASE_URL=https://your-app.fly.dev
#
# The backend must allow this site's origin (a Fly secret, not a file):
#   fly secrets set CORS_ALLOWED_ORIGINS=https://your-site.vercel.app
