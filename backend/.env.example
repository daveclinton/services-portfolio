# Copy to .env (cp .env.example .env). It configures the Docker containers,
# locally and on the VPS (/opt/services-portfolio/backend/.env).

APP_ENV=development              # production on the VPS
ADDR=127.0.0.1:8080              # Docker overrides this to 0.0.0.0:8080 inside the container
ALLOWED_ORIGINS=http://localhost:3000   # https://www.daveclintonn.cc,https://daveclintonn.cc in production
TRUST_PROXY_HEADERS=true         # safe because only nginx can reach the API

# Host ports, bound to 127.0.0.1 only. On the VPS deploy/setup.sh picks free
# ones and writes them here.
API_PORT=8080
DB_PORT=5433
EMBED_PORT=8090

# Postgres (pgvector) runs in the same compose project. Use letters and digits
# only so it's safe inside a URL:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-locally
# Docker sets DATABASE_URL for the API container itself. This value is only for
# `make run` (the API outside Docker) and the knowledge-backend pipeline.
DATABASE_URL=postgres://portfolio:change-me-locally@127.0.0.1:5433/portfolio?sslmode=disable

# OpenAI writes answers, plans retrieval and (by default) creates embeddings.
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4.1-mini    # writes answers; strong long-context instruction following
# OPENAI_INTENT_MODEL=gpt-4o-mini   # plans retrieval queries

# Semantic search. Vectors are stored in our own Postgres (pgvector) table.
# Default: OpenAI text-embedding-3-small (needs OPENAI_API_KEY; embedding the
# whole knowledge base costs well under a cent). Other options:
#   EMBEDDINGS_PROVIDER=off  full-text search only
#   EMBEDDINGS_PROVIDER=tei  self-hosted Text Embeddings Inference (needs ~500 MB
#                            free RAM); also uncomment the lines below.
# EMBEDDINGS_PROVIDER=openai
# COMPOSE_PROFILES=embeddings
# EMBEDDINGS_URL_IN_DOCKER=http://embeddings:80
# EMBEDDINGS_URL=http://127.0.0.1:8090        # only for `make run`
# EMBEDDINGS_MEMORY_LIMIT=512m
# EMBEDDINGS_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9   # Apple Silicon
# Override the provider's default model? Also set its dimensions (and task
# prefixes for self-hosted models); the API rebuilds the embeddings table.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Leave blank locally to skip rate limits. Required (32+ chars) in production:
#   openssl rand -base64 48
RATE_LIMIT_SECRET=
# AI_GLOBAL_DAILY_LIMIT=200
# SEARCH_GLOBAL_DAILY_LIMIT=2000

BREVO_API_KEY=
BREVO_ALERT_TO_EMAIL=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="David Clinton Portfolio"

# CONVERSATION_RETENTION_DAYS=30
