# Backend environment template — copy to .env and fill in real values.
#
# Anything with a credential (`SECRET_KEY`, `DATABASE_URL`, `OPENAI_API_KEY`)
# belongs in .env locally and in `fly secrets set` in production. Only this
# template is committed; .env never is.

# --- Django ---
# DEBUG defaults to False when unset, and SECRET_KEY is required whenever
# DEBUG is False, so set both for local work.
SECRET_KEY=change-me-to-something-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Every origin allowed to call this API straight from a browser (see
# lib/ai-client.ts). Production needs the deployed frontend origin, e.g.
# https://your-site.vercel.app — Fly secret, comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: origins Django trusts for CSRF-protected views (the admin). Defaults
# to CORS_ALLOWED_ORIGINS, which is what the deployed site needs.
# CSRF_TRUSTED_ORIGINS=https://your-site.vercel.app

# --- PostgreSQL ---
# Either a single URL (Neon) or the individual parts (docker). DATABASE_URL wins
# when both are set. Use the *direct* (5432) connection, not the pooled one, so
# migrations can run.
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Hosted Postgres (Neon) needs SSL. Uncomment for Neon when NOT using DATABASE_URL:
# POSTGRES_SSLMODE=require
# Seconds to keep a pooled connection alive. 0 locally so the test database
# drops cleanly; production sets 60 in fly.toml.
DB_CONN_MAX_AGE=0

# --- Markdown knowledge base (Phase 2 ingestion) ---
# A separate repo, read only by `manage.py ingest_knowledge`. Defaults to
# ~/professional-knowledge when unset.
KNOWLEDGE_BASE_PATH=/absolute/path/to/professional-knowledge

# --- AI (Phases 5-9) ---
# Get a key at https://platform.openai.com/api-keys. Never commit the real key.
# Without it the API still answers, streaming an error frame; only grounded
# answers and `embed_knowledge` need it.
# OPENAI_API_KEY=sk-...
# Model overrides for embedded answers and embeddings. Defaults are fine.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
