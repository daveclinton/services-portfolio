# Offline pipeline environment — copy to .env and fill in real values.
# This project runs management commands only; no web server settings are needed.

# PostgreSQL: DATABASE_URL takes precedence over POSTGRES_*.
# Use the same database as the Next.js app, with a direct connection for migrations.
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# For hosted Postgres when NOT using DATABASE_URL:
# POSTGRES_SSLMODE=require

# Separate Markdown knowledge repository, read by ingest_knowledge.
# Defaults to ~/professional-knowledge when unset.
KNOWLEDGE_BASE_PATH=/absolute/path/to/professional-knowledge

# Required for embed_knowledge and semantic retrieval evaluation.
# Structured evaluation and embedding dry runs work without a key.
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
